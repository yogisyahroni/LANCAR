<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release baseline: no HTTP traffic is permitted. Local development
         exceptions live only in src/debug/res/xml/network_security_config.xml. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
