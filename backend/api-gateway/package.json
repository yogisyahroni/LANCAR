{
  "name": "api-gateway",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test:auth-matrix": "npm run build && node scripts/routeAuthMatrix.test.js",
    "test:cors": "npm run build && node scripts/corsPolicy.test.js",
    "test:ops-surface": "npm run build && node scripts/opsSurfaceProtection.test.js",
    "test:public-abuse": "npm run build && node scripts/publicEndpointAbuseProtection.test.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Neuradash API Gateway with Zod Validation",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "opossum": "^9.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/opossum": "^8.1.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
