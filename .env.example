# ============================================================
# TEMBUS — Environment Variables Template
# Salin file ini: cp .env.example .env
# JANGAN commit file .env ke Git
# ============================================================

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=tembus
POSTGRES_PORT=5432

# Connection string (digunakan langsung oleh services)
DATABASE_URL="postgresql://postgres:1234@localhost:5432/tembus?sslmode=disable"

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_PORT=6379
# Kosongkan jika tidak pakai password di local
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────
# SERVICE PORTS
# ─────────────────────────────────────────────
AUTH_PORT=8081
ADMIN_PORT=3000
ROUTING_PORT=8082

# ─────────────────────────────────────────────
# AUTH / JWT
# ─────────────────────────────────────────────
# WAJIB ganti di production: minimal 32 karakter random
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_characters_here
OTP_TTL_SECONDS=300

# ─────────────────────────────────────────────
# WHATSAPP / OTP PROVIDER
# Gunakan WATI atau Twilio
# ─────────────────────────────────────────────
WATI_API_URL=https://live-mt-server.wati.io/your_account_id
WATI_API_TOKEN=your_wati_bearer_token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─────────────────────────────────────────────
# PAYMENT GATEWAY
# ─────────────────────────────────────────────
# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox   # sandbox | production
MIDTRANS_FINISH_URL=http://localhost:3000/orders
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# Xendit (alternatif)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# ─────────────────────────────────────────────
# PAYOUT / DISBURSEMENT
# ─────────────────────────────────────────────
XENDIT_DISBURSEMENT_KEY=
FLIP_SECRET_KEY=

# ─────────────────────────────────────────────
# GOOGLE MAPS
# ─────────────────────────────────────────────
# Jangan pakai satu unrestricted key untuk semua surface.
# Server key production sebaiknya masuk lewat Admin Maps Runtime encrypted credential store.
# GOOGLE_MAPS_API_KEY/GOOGLE_DIRECTIONS_API_KEY hanya legacy bootstrap fallback backend server-side.
# GOOGLE_MAPS_BROWSER_API_KEY dipakai web customer/admin dan wajib dibatasi HTTPS HTTP referrer.
# GOOGLE_MAPS_ANDROID_*_API_KEY dipakai build Android dan wajib dibatasi package name + SHA-1.
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_BROWSER_MAP_ID=
GOOGLE_MAPS_ANDROID_COURIER_API_KEY=
GOOGLE_MAPS_ANDROID_CUSTOMER_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_DISTANCE_MATRIX_URL=https://maps.googleapis.com/maps/api/distancematrix/json
MAPS_CREDENTIAL_ENCRYPTION_KEY=
MAPS_RUNTIME_CREDENTIAL_CACHE_TTL_SECONDS=30

# Non-secret metadata for admin Maps Production Readiness. Actual Android keys may live only in CI secrets.
GOOGLE_MAPS_ANDROID_COURIER_KEY_CONFIGURED=false
GOOGLE_MAPS_ANDROID_COURIER_KEY_ALIAS=tembus-staging-android-courier-maps-key
GOOGLE_MAPS_ANDROID_COURIER_KEY_RESTRICTION=android_package_sha1
GOOGLE_MAPS_ANDROID_COURIER_KEY_APIS=maps_sdk_android
GOOGLE_MAPS_ANDROID_COURIER_KEY_ROTATED_AT=
GOOGLE_MAPS_ANDROID_CUSTOMER_KEY_CONFIGURED=false
GOOGLE_MAPS_ANDROID_CUSTOMER_KEY_ALIAS=tembus-staging-android-customer-maps-key
GOOGLE_MAPS_ANDROID_CUSTOMER_KEY_RESTRICTION=android_package_sha1
GOOGLE_MAPS_ANDROID_CUSTOMER_KEY_APIS=maps_sdk_android
GOOGLE_MAPS_ANDROID_CUSTOMER_KEY_ROTATED_AT=
GOOGLE_MAPS_WEB_KEY_CONFIGURED=false
GOOGLE_MAPS_WEB_KEY_ALIAS=tembus-staging-web-maps-key
GOOGLE_MAPS_WEB_KEY_RESTRICTION=http_referrer
GOOGLE_MAPS_WEB_KEY_APIS=maps_javascript_api
GOOGLE_MAPS_WEB_KEY_ROTATED_AT=

# Runtime maps provider fallback. Admin can switch provider without rebuilding apps.
MAPS_PROVIDER_DEFAULT=openstreetmap
OSM_ROUTING_BASE_URL=https://router.project-osrm.org
OSM_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=TEMBUS-Logistics/1.0 ops@tembus.id

# ─────────────────────────────────────────────
# PUSH NOTIFICATIONS
# ─────────────────────────────────────────────
# Backend FCM memakai Firebase Admin SDK. Isi JSON service account sebagai satu baris env.
# Jangan commit service account asli ke Git.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_B64=
# Jika customer dan kurir memakai Firebase project berbeda, isi env multi-project berikut.
FIREBASE_CUSTOMER_PROJECT_ID=
FIREBASE_CUSTOMER_SERVICE_ACCOUNT=
FIREBASE_CUSTOMER_SERVICE_ACCOUNT_B64=
FIREBASE_COURIER_PROJECT_ID=
FIREBASE_COURIER_SERVICE_ACCOUNT=
FIREBASE_COURIER_SERVICE_ACCOUNT_B64=
FCM_SERVER_KEY=
FCM_PROJECT_ID=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# ─────────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────────
# AWS S3 atau compatible (Cloudflare R2, MinIO)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=tembus-uploads
S3_CDN_URL=

# ─────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development
# Local development only. Dipakai untuk akun seed kurir dengan pin_hash placeholder "hashed_pin".
# Tidak dipakai di production karena service menolak seed PIN saat NODE_ENV=production.
DEV_SEEDED_COURIER_PIN=kurir123

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_OTP_SEND_PER_5MIN=3
RATE_LIMIT_OTP_VERIFY_MAX_ATTEMPTS=5

# ─────────────────────────────────────────────
# CORS (pisahkan dengan koma jika lebih dari 1)
# ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────
# SENTRY (Error Tracking)
# ─────────────────────────────────────────────
SENTRY_DSN=

# ─────────────────────────────────────────────
# OBSERVABILITY / OPENTELEMETRY
# ─────────────────────────────────────────────
# Default local development boleh mati. Jika dinyalakan, aplikasi mengirim OTLP
# ke collector internal, bukan langsung ke Jaeger/vendor.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=
GATEWAY_OTEL_SERVICE_NAME=api-gateway
ADMIN_OTEL_SERVICE_NAME=admin-service
AUTH_OTEL_SERVICE_NAME=auth-service
ROUTING_OTEL_SERVICE_NAME=routing-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
