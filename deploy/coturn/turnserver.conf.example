listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49260
realm=turn.tembus.example
server-name=turn.tembus.example
use-auth-secret
static-auth-secret=CHANGE_ME_WITH_32_BYTES_MINIMUM_FROM_ENV
fingerprint
lt-cred-mech
no-multicast-peers
no-cli
no-tlsv1
no-tlsv1_1
mobility
prometheus
cert=/etc/coturn/tls/fullchain.pem
pkey=/etc/coturn/tls/privkey.pem
log-file=stdout
