# ============================================================
# TEMBUS — Podman Compose (WSL Rootless - Host Network Mode)
#
# DIGUNAKAN UNTUK: Podman Desktop di Windows (WSL2 rootless)
# ALASAN: aardvark-dns + systemd tidak tersedia di WSL rootless
# SOLUSI: network_mode: host + HAPUS healthcheck (butuh systemd)
# ============================================================

services:

  # ─────────────────────────────────────────────
  # DATABASE — PostgreSQL 15 + PostGIS (Primary)
  # ─────────────────────────────────────────────
  db:
    image: postgis/postgis:15-3.4-alpine
    container_name: tembus-db
    restart: "no"
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-1234}
      POSTGRES_DB: ${POSTGRES_DB:-tembus}
    network_mode: host
    volumes:
      - tembus-db-data:/var/lib/postgresql/data

  # ─────────────────────────────────────────────
  # READ REPLICA — PostgreSQL port 5433
  # ─────────────────────────────────────────────
  db-read:
    image: postgis/postgis:15-3.4-alpine
    container_name: tembus-db-read
    restart: "no"
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-1234}
      POSTGRES_DB: ${POSTGRES_DB:-tembus}
      PGPORT: "5433"
    network_mode: host
    volumes:
      - tembus-db-read-data:/var/lib/postgresql/data

  # ─────────────────────────────────────────────
  # CACHE — Redis 7
  # ─────────────────────────────────────────────
  redis:
    image: redis:7-alpine
    container_name: tembus-redis
    restart: "no"
    command: redis-server --appendonly yes --requirepass "${REDIS_PASSWORD:-}"
    network_mode: host
    volumes:
      - tembus-redis-data:/data

  # ─────────────────────────────────────────────
  # RABBITMQ — Message Broker
  # ─────────────────────────────────────────────
  rabbitmq:
    image: rabbitmq:3.12-management
    container_name: tembus-rabbitmq
    restart: "no"
    environment:
      RABBITMQ_DEFAULT_USER: guest
      RABBITMQ_DEFAULT_PASS: guest
    network_mode: host
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq

  # ─────────────────────────────────────────────
  # AUTH SERVICE — Go 1.24
  # ─────────────────────────────────────────────
  auth-service:
    image: localhost/tembus_auth-service:latest
    pull_policy: never
    container_name: tembus-auth
    restart: "no"
    environment:
      DATABASE_URL: "postgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-1234}@localhost:5432/${POSTGRES_DB:-tembus}?sslmode=disable&search_path=public"
      READ_DATABASE_URL: "postgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-1234}@localhost:5433/${POSTGRES_DB:-tembus}?sslmode=disable&search_path=public"
      REDIS_URL: "redis://localhost:6379"
      AUTH_PORT: "${AUTH_PORT:-8081}"
      JWT_SECRET: ${JWT_SECRET:-changeme_in_production_min32chars}
      JWT_REFRESH_SECRET: ${JWT_REFRESH_SECRET:-changeme_refresh_min32chars}
      OTP_TTL_SECONDS: ${OTP_TTL_SECONDS:-300}
      ENVIRONMENT: ${ENVIRONMENT:-development}
    network_mode: host

  # ─────────────────────────────────────────────
  # ADMIN SERVICE — Node.js / TypeScript
  # ─────────────────────────────────────────────
  admin-service:
    image: localhost/tembus_admin-service:latest
    pull_policy: never
    container_name: tembus-admin
    restart: "no"
    environment:
      DATABASE_URL: "postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-1234}@localhost:5432/${POSTGRES_DB:-tembus}?sslmode=disable&search_path=public"
      READ_DATABASE_URL: "postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-1234}@localhost:5432/${POSTGRES_DB:-tembus}?sslmode=disable&search_path=public"
      REDIS_URL: "redis://localhost:6379"
      PORT: "${ADMIN_PORT:-3001}"
      ENVIRONMENT: ${ENVIRONMENT:-development}
      SEED_DB: "true"
    network_mode: host

  # ─────────────────────────────────────────────
  # ROUTING SERVICE — Go
  # ─────────────────────────────────────────────
  routing-service:
    image: localhost/tembus_routing-service:latest
    pull_policy: never
    container_name: tembus-routing
    restart: "no"
    environment:
      DATABASE_URL: "postgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-1234}@localhost:5432/${POSTGRES_DB:-tembus}?sslmode=disable&search_path=public"
      REDIS_URL: "redis://localhost:6379"
      ROUTING_PORT: "${ROUTING_PORT:-8082}"
      ENVIRONMENT: ${ENVIRONMENT:-development}
    network_mode: host

  # ─────────────────────────────────────────────
  # ORDER SERVICE — Go
  # ─────────────────────────────────────────────
  order-service:
    image: localhost/tembus_order-service:latest
    pull_policy: never
    container_name: tembus-order
    restart: "no"
    environment:
      DATABASE_URL: "postgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-1234}@localhost:5432/${POSTGRES_DB:-tembus}?sslmode=disable&search_path=public"
      READ_DATABASE_URL: "postgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-1234}@localhost:5433/${POSTGRES_DB:-tembus}?sslmode=disable&search_path=public"
      REDIS_URL: "redis://localhost:6379"
      ORDER_PORT: "${ORDER_PORT:-8083}"
      GOOGLE_MAPS_API_KEY: ${GOOGLE_MAPS_API_KEY:-}
      RABBITMQ_URL: "amqp://guest:guest@localhost:5672/"
      ENVIRONMENT: ${ENVIRONMENT:-development}
    network_mode: host

  # ─────────────────────────────────────────────
  # API GATEWAY — Node.js / Express
  # ─────────────────────────────────────────────
  api-gateway:
    image: localhost/tembus_api-gateway:latest
    pull_policy: never
    container_name: tembus-gateway
    restart: "no"
    environment:
      AUTH_SERVICE_URL: "http://localhost:8081"
      ORDER_SERVICE_URL: "http://localhost:8083"
      ADMIN_SERVICE_URL: "http://localhost:3001"
      ROUTING_SERVICE_URL: "http://localhost:8082"
      GATEWAY_PORT: "8080"
    network_mode: host

  # ─────────────────────────────────────────────
  # FRONTEND — Next.js
  # ─────────────────────────────────────────────
  frontend:
    image: localhost/tembus_frontend:latest
    pull_policy: never
    container_name: tembus-frontend
    restart: "no"
    environment:
      NEXT_PUBLIC_API_URL: "http://localhost:8080/api/v1"
      NEXT_PUBLIC_WS_URL: "ws://localhost:8080"
    network_mode: host

  # ─────────────────────────────────────────────
  # ADMIN DASHBOARD — Vite / React
  # ─────────────────────────────────────────────
  admin-dashboard:
    image: localhost/tembus_admin-dashboard:latest
    pull_policy: never
    container_name: tembus-admin-ui
    restart: "no"
    environment:
      VITE_API_URL: "http://localhost:8080/api/v1"
      VITE_WS_URL: "ws://localhost:8080"
    network_mode: host

volumes:
  tembus-db-data:
    name: tembus-db-data
  tembus-db-read-data:
    name: tembus-db-read-data
  tembus-redis-data:
    name: tembus-redis-data
  rabbitmq_data:
    name: rabbitmq_data
