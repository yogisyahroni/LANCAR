# ============================================================
# LANCAR - Production Environment Template for VPS
#
# Copy on the VPS only:
#   sudo mkdir -p /opt/lancar/secrets
#   sudo cp .env.production.example /opt/lancar/secrets/.env.production
#   sudo chmod 600 /opt/lancar/secrets/.env.production
#
# Do not commit the real .env.production file.
# Generate secrets with:
#   openssl rand -base64 48
# ============================================================

COMPOSE_PROJECT_NAME=lancar-production
PUBLIC_BIND=127.0.0.1
GATEWAY_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
ADMIN_DASHBOARD_HOST_PORT=3002

POSTGRES_USER=lancar_app
POSTGRES_PASSWORD=
POSTGRES_DB=lancar

# Keep DATABASE_URL and MIGRATION_DATABASE_DSN aligned with POSTGRES_* above.
# URL-encode special characters in POSTGRES_PASSWORD if needed.
DATABASE_URL=postgresql://lancar_app:PASSWORD_URL_ENCODED@db:5432/lancar?sslmode=disable
READ_DATABASE_URL=postgresql://lancar_app:PASSWORD_URL_ENCODED@db:5432/lancar?sslmode=disable
MIGRATION_DATABASE_DSN=host=db port=5432 user=lancar_app password=PASSWORD_RAW dbname=lancar sslmode=disable

REDIS_PASSWORD=
REDIS_URL=redis://:REDIS_PASSWORD_URL_ENCODED@redis:6379

RABBITMQ_DEFAULT_USER=lancar_queue
RABBITMQ_DEFAULT_PASS=
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_URL=amqp://lancar_queue:RABBITMQ_PASSWORD_URL_ENCODED@rabbitmq:5672/

JWT_SECRET=
JWT_REFRESH_SECRET=
INTERNAL_GATEWAY_SECRET=
METRICS_BEARER_TOKEN=

# Optional. If omitted in production, /docs/* returns 404.
DOCS_BASIC_AUTH_USERNAME=
DOCS_BASIC_AUTH_PASSWORD=
API_DOCS_ENABLED=false

OTP_TTL_SECONDS=300
REQUIRE_IDEMPOTENCY_KEYS=true

# Public URLs behind your reverse proxy/domain.
FRONTEND_URL=https://app.example.com
PUBLIC_APP_URL=https://app.example.com
MIDTRANS_FINISH_URL=https://app.example.com/orders
RECEIVER_LOCATION_PUBLIC_URL=https://app.example.com/location-requests
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_WS_URL=https://api.example.com
NEXT_PUBLIC_SOCKET_URL=https://api.example.com
VITE_API_URL=https://api.example.com/api/v1
VITE_WS_URL=https://api.example.com
VITE_SOCKET_URL=https://api.example.com

MIDTRANS_ENV=production
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IRIS_API_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.midtrans.com/snap/snap.js

GOOGLE_MAPS_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_CUSTOMER_PROJECT_ID=
FIREBASE_CUSTOMER_SERVICE_ACCOUNT_B64=
FIREBASE_COURIER_PROJECT_ID=
FIREBASE_COURIER_SERVICE_ACCOUNT_B64=
FCM_PROJECT_ID=

STORAGE_DRIVER=local
UPLOAD_PRIVATE_DIR=/app/storage/uploads
UPLOAD_URL=
AWS_REGION=
S3_BUCKET=
S3_BUCKET_NAME=

VERIHUBS_APP_ID=
VERIHUBS_API_KEY=
VERIHUBS_API_URL=

# Optional: set these to GHCR images when deploying prebuilt artifacts from CI.
# AUTH_SERVICE_IMAGE=ghcr.io/owner/repo/auth-service:staging
# ROUTING_SERVICE_IMAGE=ghcr.io/owner/repo/routing-service:staging
# ORDER_SERVICE_IMAGE=ghcr.io/owner/repo/order-service:staging
# PAYMENT_SERVICE_IMAGE=ghcr.io/owner/repo/payment-service:staging
# ADMIN_SERVICE_IMAGE=ghcr.io/owner/repo/admin-service:staging
# API_GATEWAY_IMAGE=ghcr.io/owner/repo/api-gateway:staging
# FRONTEND_IMAGE=ghcr.io/owner/repo/frontend:staging
# ADMIN_DASHBOARD_IMAGE=ghcr.io/owner/repo/admin-dashboard:staging
