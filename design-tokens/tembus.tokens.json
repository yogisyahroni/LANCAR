{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "product": "TEMBUS",
  "version": "1.0.0",
  "figma": {
    "file": "https://www.figma.com/design/9JTlREMJNVkLYchQD1QcpV",
    "foundationsPage": "Foundations & Components",
    "mappingRule": "Figma role names map to the semantic token path; platform outputs are generated from this file."
  },
  "themes": {
    "light": {
      "color": {
        "background": "#F7F8F7",
        "surface": "#FFFFFF",
        "surface-raised": "#FFFFFF",
        "surface-subtle": "#EEF3EF",
        "foreground": "#14211A",
        "foreground-secondary": "#415047",
        "foreground-muted": "#5F6B63",
        "border": "#C7D1CA",
        "border-strong": "#718078",
        "input-background": "#FFFFFF",
        "input-border": "#66756C",
        "focus-ring": "#9A3412",
        "primary": "#006437",
        "primary-light": "#007A42",
        "primary-dark": "#003A20",
        "primary-soft": "#E8F5EE",
        "primary-pale": "#F4FBF7",
        "on-primary": "#FFFFFF",
        "accent": "#C2410C",
        "accent-dark": "#9A3412",
        "accent-light": "#EA580C",
        "accent-soft": "#FFF1E6",
        "accent-pale": "#FFF8F2",
        "on-accent": "#FFFFFF",
        "success": "#15803D",
        "on-success": "#FFFFFF",
        "success-surface": "#DCFCE7",
        "warning": "#B45309",
        "on-warning": "#FFFFFF",
        "warning-surface": "#FEF3C7",
        "error": "#B91C1C",
        "on-error": "#FFFFFF",
        "error-surface": "#FEE2E2",
        "info": "#1D4ED8",
        "on-info": "#FFFFFF",
        "info-surface": "#DBEAFE",
        "selection": "#B7E4C7",
        "scrim": "#14211A"
      }
    },
    "dark": {
      "color": {
        "background": "#0B120E",
        "surface": "#142019",
        "surface-raised": "#1B2921",
        "surface-subtle": "#203329",
        "foreground": "#F4F7F5",
        "foreground-secondary": "#D0DBD3",
        "foreground-muted": "#AAB5AE",
        "border": "#4B5D52",
        "border-strong": "#71877A",
        "input-background": "#142019",
        "input-border": "#71877A",
        "focus-ring": "#FDBA74",
        "primary": "#34D399",
        "primary-light": "#6EE7B7",
        "primary-dark": "#007A42",
        "primary-soft": "#123B25",
        "primary-pale": "#0D3322",
        "on-primary": "#032318",
        "accent": "#FB923C",
        "accent-dark": "#C2410C",
        "accent-light": "#FDBA74",
        "accent-soft": "#4A3210",
        "accent-pale": "#3D2414",
        "on-accent": "#241000",
        "success": "#4ADE80",
        "on-success": "#032318",
        "success-surface": "#123B25",
        "warning": "#FBBF24",
        "on-warning": "#241000",
        "warning-surface": "#4A3210",
        "error": "#F87171",
        "on-error": "#2A0808",
        "error-surface": "#4A1717",
        "info": "#60A5FA",
        "on-info": "#071A35",
        "info-surface": "#132E52",
        "selection": "#1A7A4C",
        "scrim": "#000000"
      }
    }
  },
  "global": {
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "32px"
    },
    "radius": {
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "pill": "999px"
    },
    "typography": {
      "display": "clamp(2.25rem, 5vw, 3.75rem)",
      "page-title": "clamp(1.75rem, 3vw, 2.25rem)",
      "section-title": "1.25rem",
      "body": "1rem",
      "body-small": "0.875rem",
      "label": "0.8125rem",
      "caption": "0.75rem",
      "table-cell": "0.8125rem"
    },
    "elevation": {
      "none": "none",
      "raised": "0 4px 16px rgba(20, 33, 26, 0.12)",
      "overlay": "0 12px 32px rgba(20, 33, 26, 0.18)"
    },
    "motion": {
      "fast": "150ms",
      "standard": "200ms",
      "slow": "300ms",
      "easing": "cubic-bezier(0.2, 0, 0, 1)",
      "reduced": "0ms"
    },
    "size": {
      "min-touch-target": "48px",
      "control-large": "56px",
      "icon": "24px",
      "icon-small": "16px"
    },
    "content": {
      "max-width": "1200px",
      "grid-gap": "16px"
    }
  },
  "wcagProtectedPairs": [
    { "foreground": "foreground", "background": "background", "minimum": 4.5, "purpose": "normal text on page background" },
    { "foreground": "foreground-secondary", "background": "background", "minimum": 4.5, "purpose": "secondary text on page background" },
    { "foreground": "foreground-muted", "background": "background", "minimum": 4.5, "purpose": "muted text on page background" },
    { "foreground": "foreground", "background": "surface", "minimum": 4.5, "purpose": "normal text on surfaces" },
    { "foreground": "foreground-secondary", "background": "surface", "minimum": 4.5, "purpose": "secondary text on surfaces" },
    { "foreground": "foreground-muted", "background": "surface", "minimum": 4.5, "purpose": "muted text on surfaces" },
    { "foreground": "on-primary", "background": "primary", "minimum": 4.5, "purpose": "primary action text" },
    { "foreground": "on-accent", "background": "accent", "minimum": 4.5, "purpose": "accent action text" },
    { "foreground": "on-success", "background": "success", "minimum": 4.5, "purpose": "success status text" },
    { "foreground": "on-warning", "background": "warning", "minimum": 4.5, "purpose": "warning status text" },
    { "foreground": "on-error", "background": "error", "minimum": 4.5, "purpose": "error status text" },
    { "foreground": "on-info", "background": "info", "minimum": 4.5, "purpose": "info status text" },
    { "foreground": "border-strong", "background": "background", "minimum": 3, "purpose": "essential component boundary" },
    { "foreground": "input-border", "background": "input-background", "minimum": 3, "purpose": "input boundary" },
    { "foreground": "focus-ring", "background": "background", "minimum": 3, "purpose": "keyboard focus indicator" },
    { "foreground": "focus-ring", "background": "surface", "minimum": 3, "purpose": "keyboard focus indicator on surfaces" },
    { "foreground": "success", "background": "success-surface", "minimum": 4.5, "purpose": "status text on tinted surface" },
    { "foreground": "warning", "background": "warning-surface", "minimum": 4.5, "purpose": "status text on tinted surface" },
    { "foreground": "error", "background": "error-surface", "minimum": 4.5, "purpose": "status text on tinted surface" },
    { "foreground": "info", "background": "info-surface", "minimum": 4.5, "purpose": "status text on tinted surface" },
    { "foreground": "primary", "background": "background", "minimum": 4.5, "purpose": "brand text on page background" },
    { "foreground": "accent", "background": "background", "minimum": 4.5, "purpose": "accent text on page background" },
    { "foreground": "focus-ring", "background": "surface-subtle", "minimum": 3, "purpose": "focus indicator on subtle surfaces" }
  ],
  "platformMappings": {
    "cssVariablePrefix": "--token-",
    "androidColorFile": "android-app-customer/app/src/main/java/com/tembus/customer/ui/theme/Color.kt",
    "android": {
      "light": {
        "background": "Background",
        "surface": "Surface",
        "surface-raised": "Surface",
        "surface-subtle": "SurfaceVariant",
        "foreground": "OnBackground",
        "foreground-secondary": "OnSurfaceSecondary",
        "foreground-muted": "OnSurfaceVariant",
        "border": "Outline",
        "border-strong": "OutlineStrong",
        "input-background": "Surface",
        "input-border": "InputBorder",
        "focus-ring": "AccentDark",
        "primary": "Primary",
        "primary-light": "PrimaryLight",
        "primary-dark": "PrimaryDark",
        "primary-soft": "PrimarySoft",
        "primary-pale": "PrimaryPale",
        "on-primary": "OnPrimary",
        "accent": "Accent",
        "accent-dark": "AccentDark",
        "accent-light": "AccentLight",
        "accent-soft": "AccentSoft",
        "accent-pale": "AccentPale",
        "on-accent": "OnAccent",
        "success": "Success",
        "warning": "Warning",
        "error": "Error",
        "info": "Info"
      },
      "dark": {
        "background": "DarkBackground",
        "surface": "DarkSurface",
        "surface-raised": "DarkSurfaceVariant",
        "surface-subtle": "DarkSurfaceSubtle",
        "foreground": "DarkOnBackground",
        "foreground-secondary": "DarkOnSurfaceSecondary",
        "foreground-muted": "DarkOnSurfaceVariant",
        "border": "DarkOutline",
        "border-strong": "DarkOutlineStrong",
        "input-background": "DarkSurface",
        "input-border": "DarkInputBorder",
        "focus-ring": "DarkAccentLight",
        "primary": "DarkPrimary",
        "primary-light": "DarkPrimaryLight",
        "primary-dark": "DarkPrimaryDark",
        "primary-soft": "DarkPrimarySoft",
        "primary-pale": "DarkPrimaryPale",
        "on-primary": "DarkOnPrimary",
        "accent": "DarkAccent",
        "accent-dark": "DarkAccentDark",
        "accent-light": "DarkAccentLight",
        "accent-soft": "DarkAccentSoft",
        "accent-pale": "DarkAccentPale",
        "on-accent": "DarkOnAccent",
        "success": "DarkSuccess",
        "warning": "DarkWarning",
        "error": "DarkError",
        "info": "DarkInfo"
      }
    }
  }
}
